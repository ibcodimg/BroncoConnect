# Copy this file to server/.env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Use a NEW password, not one that has been pasted anywhere.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster (keeps app data separate from sample_mflix).
MONGODB_DB=broncoconnect

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
